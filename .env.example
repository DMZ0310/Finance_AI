# AI Financial Assistant - Environment Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (required)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# App Configuration
APP_TITLE=FinanceAI Assistant
APP_VERSION=1.0.0

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./app/embeddings/chroma_db

# Optional: Auth (set to "true" to enable simple password protection)
ENABLE_AUTH=false
APP_PASSWORD=financeai2024

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
